---
import type { LinkProps as Props } from '@/components/types'

const {
  to,
  title,
  btn = false,
  external = false,
  featured = false,
  class: extraClass,
  'aria-label': ariaLabel,
  ...restProps
} = Astro.props
const target = external ? '_blank' : null
const rel = external ? 'noopener noreferrer' : null
---

<a
  {rel}
  {title}
  {target}
  href={to}
  aria-label={ariaLabel}
  class:list={[{ btn, link: !btn, featured }, extraClass]}
  {...restProps}
>
  <slot />
  {external && ariaLabel == null && <span class="sr-only">(opens in new tab)</span>}
</a>
